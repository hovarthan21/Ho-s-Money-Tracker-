# Required on Vercel (use a free Neon / Vercel Postgres database)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
SECRET_KEY=put-a-long-random-text-here
# Optional: only these usernames can be created (comma separated). Strongly recommended.
ALLOWED_USERS=ho
# Optional: for low balance emails (Gmail + App Password)
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
